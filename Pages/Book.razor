@page "/book"
@using Faded.Models
@using Faded.Services
@using Microsoft.AspNetCore.Components.Forms
@inject BookingService BookingService
@inject AuthService AuthService

<PageTitle>Book a Cut - Faded</PageTitle>

<div class="booking-page">
    <h1>Book Your Cut</h1>

    @if (_barbers is null || _services is null)
    {
        <p>Loading...</p>
    }
    else
    {
        <div class="booking-form">

            <label>Your Name</label>
            <input @bind="_customerName" placeholder="Full name" />

            <label>Email</label>
            <input @bind="_customerEmail" type="email" placeholder="you@example.com" />

            <label>Phone</label>
            <input @bind="_customerPhone" placeholder="082 123 4567" />

            <label>Service</label>
            <select @bind="_selectedServiceId">
                <option value="">-- Choose a service --</option>
                @foreach (var service in _services)
                {
                    <option value="@service.Id">@service.Name — R@service.Price</option>
                }
            </select>

            <label>Barber</label>
            <select @bind="_selectedBarberId">
                <option value="">-- Choose a barber --</option>
                @foreach (var barber in _barbers)
                {
                    <option value="@barber.Id">@barber.Name</option>
                }
            </select>

            <label>Date</label>
            <input @bind="_bookingDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />

            <label>Time</label>
            <input @bind="_bookingTime" type="time" />

            <label>Payment Method</label>
            <div class="payment-methods">
                <label><input type="radio" name="payment" value="@PaymentMethod.Cash"
                    checked="@(_paymentMethod == PaymentMethod.Cash)"
                    @onchange="@(() => _paymentMethod = PaymentMethod.Cash)" /> Cash</label>

                <label><input type="radio" name="payment" value="@PaymentMethod.Card"
                    checked="@(_paymentMethod == PaymentMethod.Card)"
                    @onchange="@(() => _paymentMethod = PaymentMethod.Card)" /> Card (Transfer)</label>

                <label><input type="radio" name="payment" value="@PaymentMethod.Subscription"
                    checked="@(_paymentMethod == PaymentMethod.Subscription)"
                    @onchange="@(() => _paymentMethod = PaymentMethod.Subscription)" /> Subscription</label>
            </div>

            @if (_paymentMethod == PaymentMethod.Card)
            {
                <div class="card-upload-section">
                    <label>Upload Proof of Payment</label>
                    <InputFile OnChange="OnProofFileSelected" accept="image/*,.pdf" />
                    @if (_proofFile is not null)
                    {
                        <p class="file-selected">Selected: @_proofFile.Name</p>
                    }
                </div>
            }

            @if (_paymentMethod == PaymentMethod.Subscription)
            {
                <div class="subscription-section">
                    @if (_currentSubscriber is null)
                    {
                        <div class="auth-toggle">
                            <button type="button" @onclick="@(() => _showSignup = false)"
                                class="@(_showSignup ? "" : "active")">Log In</button>
                            <button type="button" @onclick="@(() => _showSignup = true)"
                                class="@(_showSignup ? "active" : "")">Sign Up</button>
                        </div>

                        <label>Email</label>
                        <input @bind="_authEmail" type="email" placeholder="you@example.com" />

                        <label>Password</label>
                        <input @bind="_authPassword" type="password" />

                        @if (_showSignup)
                        {
                            <label>Choose a Plan</label>
                            <select @bind="_selectedPlanId">
                                <option value="">-- Choose a plan --</option>
                                @foreach (var plan in _plans ?? new())
                                {
                                    <option value="@plan.Id">@plan.Name — R@plan.Price / @plan.CutsIncluded cuts</option>
                                }
                            </select>
                            <p class="note">Your plan locks you to the barber selected above and runs for 30 days from today.</p>
                            <button type="button" @onclick="HandleSignup">Sign Up &amp; Continue</button>
                        }
                        else
                        {
                            <button type="button" @onclick="HandleLogin">Log In</button>
                        }

                        @if (!string.IsNullOrEmpty(_authError))
                        {
                            <p class="error">@_authError</p>
                        }
                    }
                    else
                    {
                        <div class="subscriber-status">
                            @if (_currentSubscriber.IsExpired)
                            {
                                <p class="error">Your subscription expired on @_currentSubscriber.CycleEnd.ToString("dd MMM yyyy"). This booking will be treated as Cash/Card.</p>
                            }
                            else if (_currentSubscriber.CutsRemaining == 0)
                            {
                                <p class="warning">You've used all your cuts this cycle (renews @_currentSubscriber.CycleEnd.ToString("dd MMM yyyy")). This booking will need Cash or Card payment instead.</p>
                            }
                            else
                            {
                                <p class="success">@_currentSubscriber.CutsRemaining cut(s) remaining — cycle renews @_currentSubscriber.CycleEnd.ToString("dd MMM yyyy"). This booking will be auto-confirmed.</p>
                            }
                        </div>
                    }
                </div>
            }

        </div>
    }
</div>

@code {
    private List<Barber>? _barbers;
    private List<Service>? _services;

    private string _customerName = string.Empty;
    private string _customerEmail = string.Empty;
    private string _customerPhone = string.Empty;
    private string _selectedServiceId = string.Empty;
    private string _selectedBarberId = string.Empty;
    private DateTime _bookingDate = DateTime.Today;
    private TimeOnly _bookingTime = new TimeOnly(9, 0);

    private List<SubscriptionPlan>? _plans;
    private string _paymentMethod = PaymentMethod.Cash;

    private IBrowserFile? _proofFile;

    private bool _showSignup = false;
    private string _authEmail = string.Empty;
    private string _authPassword = string.Empty;
    private string _selectedPlanId = string.Empty;
    private string _authError = string.Empty;
    private Subscriber? _currentSubscriber;

    protected override async Task OnInitializedAsync()
    {
        _barbers = await BookingService.GetActiveBarbers();
        _services = await BookingService.GetActiveServices();
        _plans = await BookingService.GetActivePlans();
    }

    private void OnProofFileSelected(InputFileChangeEventArgs e)
    {
        _proofFile = e.File;
    }

    private async Task HandleLogin()
    {
        _authError = string.Empty;
        var (error, subscriber) = await AuthService.LogInSubscriber(_authEmail, _authPassword);
        if (error is not null)
        {
            _authError = error;
            return;
        }
        _currentSubscriber = subscriber;
    }

    private async Task HandleSignup()
    {
        _authError = string.Empty;
        if (string.IsNullOrEmpty(_selectedPlanId))
        {
            _authError = "Please choose a plan.";
            return;
        }
        if (string.IsNullOrEmpty(_selectedBarberId))
        {
            _authError = "Please choose a barber above first — your subscription locks to them.";
            return;
        }
        var (error, subscriber) = await AuthService.SignUpSubscriber(
            _authEmail, _authPassword, Guid.Parse(_selectedBarberId), Guid.Parse(_selectedPlanId));

        if (error is not null)
        {
            _authError = error;
            return;
        }
        _currentSubscriber = subscriber;
    }
}
